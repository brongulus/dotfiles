#!/usr/bin/env bash
# MEGA TODO Look into incorporating chat w/ emotes alongwith mpv
follows(){
    printf "forsen\n"
    printf "ppy\n"
    printf "xqc\n"
    printf "pokimane\n"
    printf "lilypichu\n"
    printf "ariasaki\n"
    printf "igumdrop\n"
    printf "ecnerwala\n"
    printf "pmavrin\n"
    printf "petrmitrichev\n"
    printf "the__tourist\n"
    printf "nealu\n"
    printf "s1mple\n"
    printf "hyoon\n"
    printf "vylerria\n"
}

main(){
    channel=$(follows | fzf --print-query --prompt "Channel: " | tail -n1);
    if [[ -z "${channel// }" ]]; then
        exit 1
    fi

    off_check=$(curl -sL https://twitch.tv/$channel | grep -c isLiveBroadcast)

    if [[ $off_check == 0 ]]; then

        selected=$(yt-dlp --flat-playlist --dump-json "https://twitch.tv/${channel}/videos?filter=all&sort=time" | jq -r '"\(.title)`\(.url)"' | fzf --height=60% \
          --header="Select a VOD (ESC to cancel) - ${channel}" \
          --delimiter="\`" \
          --with-nth=1 \
          --preview='echo {2}' \
          --preview-window=down:1:wrap)

        if [ -z "$selected" ]; then
        echo $channel ': No VOD selected' | fzf --prompt "Press Enter to try again: " --print-query > /dev/null;
            main
        fi

        echo -n "Url is: "
        vod=$(echo $selected | cut -d'`' -f2)
        echo ${vod}
        mpv --ytdl-format="bestvideo[height<=?1080]+bestaudio/best" ${vod} & sleep 5;
        # echo $channel 'is offline' | fzf --prompt "Press Enter to try again: " --print-query > /dev/null;
        # main
    else
        mpv --ytdl-format="bestvideo[height<=?1080]+bestaudio/best" --no-resume-playback https://twitch.tv/$channel & sleep 5;
        # if [[ $channel == "forsen" ]]; then 
        #     chatterino -c $channel;
        # fi
    fi

# ytdl-format="bestvideo[height<=?1080]+bestaudio/best"
# --ytdl-format="720p"
# Offline Echo message
# [ytdl_hook] ERROR: [twitch:stream] ppy: ppy is offline
# [ytdl_hook] youtube-dl failed: unexpected error occurred
}
main
