#     _
#    / \   ___  ___  _ __
#   / _ \ / _ \/ _ \| '_ \
#  / ___ \  __/ (_) | | | |
# /_/   \_\___|\___/|_| |_|
#
# A clean, modern irssi theme
#
default_color = "-1";
# Timestamp/servertag to the end, not first
info_eol = "false";
replaces = { "[]=" = "$*"; };

abstracts = {

  # Disabling client crap
  # msglevel_clientcrap = "%p*%K %W%K$*";

  # For awaybar.pl
  sb_awaybar = " %1 {sb %W$0-} %N";

  # For usercount.pl
  sb_usercount = " %0 {sb %G$0} %N ";
  sb_uc_ircops = "%r*$*";
  sb_uc_ops = "%Ro%K$*";
  sb_uc_halfops = "%Bho%b$*";
  sb_uc_voices = "%Gv%K$*";
  sb_uc_normal = "%w$*%K";
  sb_uc_space = " ";

  line_start = "";
  timestamp = " $* ";
  hilight = "$*";
  error = "$*";
  channel = "$*";
  nick = "$*";
  nickhost = "$*";
  server = "$*";
  comment = "$*";
  reason = "{comment $*}";
  mode = "{comment $*}";
  channick_hilight = "$*";
  chanhost_hilight = "{nickhost $*}";
  channick = "$*";
  chanhost = "{nickhost $*}";
  joinnick = "$*";
  channelhilight = "$*";
  ban = "$*";

  # All of below: $0 = mode, $1 = nick
  msgnick = "$0$1- %|";
  ownmsgnick = "{msgnick %G%_$1%_%K> }%w";
  ownnick = "$*";
  actionmsgnick = "{msgnick %Y%_$1%_ %Y● }";
  actionnick = "$*";

  # Highlights use red background and white text for better visibility
  # Alternative highlight styles are commented out below
  #

  pubmsgnick = "{msgnick %r%_$1%_%K> }%w";
  pubnick = "$*";
  pubmsgmenick = "%5%k{msgnick %_%k$1%_%K> }";
  menick = "$*";
  # $0 = hilight color, $1 = mode, $2 = nick
  pubmsghinick = "%5%k{msgnick %_%k$2%_%K> }";

  # Alternative message styles:
  #
  #pubmsgnick = "{msgnick %r$1%K%_|}%w";
  #pubnick = "$*";
  #pubmsgmenick = "%G%K{msgnick $1-%R|}%0%W";
  #menick = "$*%n";
  #pubmsghinick = "%G%K{msgnick $2-%R|}%0%W";

  msgchannel = ":$*";
  # $0 = nick, $1 = host
  #
  # msn-styled:
  #privmsg = "%:[$0($1-)]";
  privmsg = "[$0($1-)]";

  #
  # $0 = "msg",
  # $1 = target nick
  #

  #
  # msn-styled:
  #ownprivmsg = "%:%w[$0(%1-)]";
  ownprivmsg = "%w[$0(%1-)]";

  ownprivmsgnick = "{msgnick $*}";
  privmsgnick = "{msgnick $*}";

  #
  # msn-styled privmsgs:
  #ownprivnick = "%B$*%K says:%:";
  #privmsgnick = "%r$*%K says:%:";
  ownprivnick = "%B$*%K%_>";
  privnick = "%r$*%K%_>";
  action_core = "{actionmsgnick $[-9]0}";
  action = "%C{action_core $*}%W";
  ownaction = "{action $*}";
  ownaction_target = "{action_core $*}:$1 ";
  pvtaction = " (>>>) $* ";
  pvtaction_query = "{action $*}";
  pubaction = "{action $*}";
  ownnotice = "[$0($1-)] ";
  notice = "$*";
  whois = "%# $[8]0 : $1-";
  pubnotice_channel = ":$*";
  # pvtnotice_host = "($*)";
  pvtnotice_host = "";
  servernotice = "%r!$* %K";
  ownctcp = "[$0($1-)] ";
  ctcp = "$*";
  wallop = "$*: ";
  wallop_nick = "$*";
  wallop_action = " * $* ";
  netsplit = "$*";
  netjoin = "$*";
  names_prefix = "%p● %K";
  names_nick = "$0$1- ";
  names_nick_op = "{names_nick $*}";
  names_nick_halfop = "{names_nick $*}";
  names_nick_voice = "{names_nick $*}";
  names_users = "$*";
  names_channel = "%K$*";
  dcc = "$*";
  dccfile = "$*";
  dccownmsg = "[$0($1-)] ";
  dccownnick = "$*";
  dccownquerynick = "$*";
  dccownaction = "{action $*}";
  dccownaction_target = "{action_core $0}:$1 ";
  dccmsg = "[$1-($0)] ";
  dccquerynick = "$*";
  dccaction = " (*dcc*) $* %|";
  sb_background = "%N";
  sb_window_bg = "%k%0";
  sb_default_bg = "%N";
  sb_prompt_bg = "%N";
  sb_info_bg = "%N";
  sb_topic_bg = "%N";
  sbstart = "";
  sbend = " ";
  topicsbstart = "{sbstart $*}";
  topicsbend = "{sbend $*}";
  #prompt = "%r$*%r: ";
  prompt = "{sbaway $A}%m$*%K:%n ";
  sb = "%K$*%K";
  sbmode = "";
  sbaway = "%raway: $*%n ";
  sbservertag = "$0%K";
  sbnickmode = "";
  sb_act_sep = "%K$*%n";
  sb_act_text = "%K$*%n";
  sb_act_msg = "%G$*%n";
  sb_act_hilight = "%Y$*%n";
  sb_act_hilight_color = "%Y$*%n";
};
formats = {
  "fe-common/core" = {
    query_start = "%g● %gStarting query %Kon $1 w/ $0";
    join = "%g{joinnick $[-9]0} ● %gjoined %K{channel $2}";
    part = "%r{joinnick $[-9]0} ● %rleft %K{channel $2}";
    quit = "%r{joinnick $[-9]0} ● %rquit %K(reason: $2)";
    quit_once = "%r{joinnick $[-9]0} ● %rquit %K[$1] (reason: $2)";
    nick_changed = "%K{joinnick $[-9]0} ● is now known as $1";

    own_msg = "{ownmsgnick $2 {ownnick %G$[-10]0}}%W$1";
    own_msg_channel = "{ownmsgnick $3 {ownnick %G$[-10]0}}{msgchannel $1}%w$2";
    pubmsg_me = "{pubmsgmenick $2 {menick %k$[-10]0}}%5%k$1%n";
    pubmsg_me_channel = "{pubmsgmenick $3 {menick %k$[-10]0}}{msgchannel $1}%5%k$2%n";
    pubmsg_hilight = "{pubmsghinick $0 $3 %k$[-10]1}%5%k$2%n";
    pubmsg_hilight_channel = "{pubmsghinick $0 $4 %k$[-10]1}{msgchannel $2}%5%k$3%n";
    pubmsg = "{pubmsgnick $2 {pubnick $nickcolor$[-10]0}}$1";
    pubmsg_channel = "{pubmsgnick $3 {pubnick $[-10]0}}{msgchannel $1}$2";

    #   own_msg = "{ownmsgnick $2 {ownnick $[-10]0}}$1";
    #   own_msg_channel = "{ownmsgnick $3 {ownnick $[-10]0}{msgchannel $1}}$2";
    #pubmsg_me = "{pubmsgmenick $2 {menick $[-9]0}}$1";
    #   pubmsg_me_channel = "{pubmsgmenick $3 {menick $[-10]0}{msgchannel $1}}$2";
    #   pubmsg_hilight = "{pubmsghinick $0 $3 $[-10]1}$2";
    #   pubmsg_hilight_channel = "{pubmsghinick $0 $4 $[-10]1{msgchannel $2}}$3";
    #   pubmsg = "{pubmsgnick $2 {pubnick \0030$0}}$1";
    #   pubmsg_channel = "{pubmsgnick $3 {pubnick $[-10]0}{msgchannel $1}}$2";
    #   line_start = "{line_start}";
    #   line_start_irssi = "{line_start}{hilight Irssi} %W|%n ";
    line_start_irssi = "%K{line_start}";
    timestamp = "%K{timestamp %K$Z} %W";
    #   servertag = "$[-11]0 %W|%n ";
    servertag = "%K";
    daychange = "%K%_00:00:00%_ %p● %pDay changed! Still up? Today is %%d. %%b, Anno Domini %%Y.";
    talking_with = "%p● %pYou are now having a conversation with %p$0";
    refnum_too_low = "%r● %rWindow number must be greater than one";
    error_server_sticky = "%r● %rWindow's server is sticky and it cannot be changed without -unsticky option";
    set_server_sticky = "%g● %gWindow's server set sticky";
    unset_server_sticky = "%g● %gWindow's server isn't sticky anymore";
    window_name_not_unique = "%r● %rWindow names must be unique";
    window_level = "%g● %gWindow level is now $0";
    windowlist_header = "Ref Name                 Active item     Server          Level";
    windowlist_line = "$[3]0 %|$[20]1 $[15]2 $[15]3 $4";
    windowlist_footer = "";
    windows_layout_saved = "%g● %gLayout of windows is now remembered next time you start irssi";
    windows_layout_reset = "%g● %gLayout of windows reset to defaults";
    window_info_header = "";
    window_info_footer = "";
    window_info_refnum = "Window  : {hilight #$0}";
    window_info_refnum_sticky = "Window  : {hilight #$0 (sticky)}";
    window_info_name = "Name    : $0";
    window_info_history = "History : $0";
    window_info_size = "Size    : $0x$1";
    window_info_level = "Level   : $0";
    window_info_server = "Server  : $0";
    window_info_server_sticky = "Server  : $0 (sticky)";
    window_info_theme = "Theme   : $0$1";
    window_info_bound_items_header = "Bounds  : {hilight Name                           Server tag}";
    window_info_bound_item = "        : $[!30]0 $[!15]1 $2";
    window_info_bound_items_footer = "";
    window_info_items_header = "Items   : {hilight Name                           Server tag}";
    window_info_item = " $[7]0: $[!30]1 $2";
    window_info_items_footer = "";
    looking_up = "%g● %gLooking up {server $0}";
    connecting = "%g● %gConnecting to {server $0} [$1] port {hilight $2}";
    connection_established = "%g● %gConnection to {server $0} established";
    cant_connect = "%r● %rUnable to connect server {server $0} port {hilight $1} {reason $2}";
    connection_lost = "%r● %rConnection lost to {server $0}";
    lag_disconnected = "%r● %rNo PONG reply from server {server $0} in $1 seconds, disconnecting";
    disconnected = "%r● %rDisconnected from {server $0} {reason $1}";
    server_quit = "%r● %rDisconnecting from server {server $0}: {reason $1}";
    server_changed = "%y● %yChanged to {hilight $2} server {server $1}";
    unknown_server_tag = "%r● %rUnknown server tag {server $0}";
    no_connected_servers = "%r● %rNot connected to any servers";
    server_list = "{server $0}: $1:$2 ($3)";
    server_lookup_list = "{server $0}: $1:$2 ($3) (connecting...)";
    server_reconnect_list = "{server $0}: $1:$2 ($3) ($5 left before reconnecting)";
    server_reconnect_removed = "%g● %gRemoved reconnection to server {server $0} port {hilight $1}";
    server_reconnect_not_found = "%r● %rReconnection tag {server $0} not found";
    setupserver_added = "%g● %gServer {server $0} saved";
    setupserver_removed = "%g● %gServer {server $0} removed";
    setupserver_not_found = "%r● %rServer {server $0} not found";
    your_nick = "%p● %pYour nickname is %K$0";
    kick = "%r{joinnick $[-9]0} ● %rwas kicked %Kfrom $1 by $2 ($3)";
    invite = "%y{joinnick $[-9]0} ● %yinvites you to %K$1";
    not_invited = "You have not been invited to a channel!";
    new_topic = "%m{joinnick $[-9]0} ● %mchanged topic %Kof $1 to: $2";
    topic_unset = "%m{joinnick $[-9]0} ● %mremoved the topic %Kon $1";
    your_nick_changed = "%y● %yYou are now better known as %Knickname $1";
    talking_in = "%p● %pYou are now on %p$0";
    not_in_channels = "%p● %pYou are not on any channels";
    current_channel = "%p● %pCurrent channel %p$0";
    names = "%p● %p{names_users Users: {names_channel $0}}: {comment $1}";
    names_prefix = "%K{names_prefix $0}";
    names_nick_op = "%p{names_nick_op $0 $1}";
    names_nick_halfop = "%p{names_nick_halfop $0 $1}";
    names_nick_voice = "%p{names_nick_voice $0 $1}";
    names_nick = "%p{names_nick $0 $1}";
    endofnames = "%p● %p{channel $0}: Total: {hilight $1} users ({comment {hilight $2} ops, {hilight $3} halfops, {hilight $4} voiced, {hilight $5} normal users.})";
    chanlist_header = "%p● %pYou are on the following channel:";
    chanlist_line = "{channel $[-9]0} %|+$1 ($2): $3";
    chansetup_not_found = "Channel {channel $0} not found";
    chansetup_added = "Channel {channel $0} saved";
    chansetup_removed = "Channel {channel $0} removed";
    chansetup_header = "Channel         Network    Password   Settings";
    chansetup_line = "{channel $[15]0} %|$[10]1 $[10]2 $3";
    chansetup_footer = "";
    channel_move_notify = "{channel $0} is already joined in window $1, use \"/WINDOW ITEM MOVE $0\" to move it to this window";

    #    own_msg_private = "{ownprivmsg msg $0}$1";
    #    own_msg_private_query = "{ownprivmsgnick {ownprivnick $[-9]2}}$1";
    #    msg_private = "{privmsg $0 $1}$2";
    #    msg_private_query = "{privmsgnick $[-9]0}$2";

    no_msgs_got = "%p● %pYou have not received a message from anyone yet";
    no_msgs_sent = "%p● %pYou have not sent a message to anyone yet";
    query_stop = "%p● %pA conversation with %p$0 %pis ended";
    no_query = "%p● %pNo query with %p$0";
    query_server_changed = "%y● %yQuery with %y$0 %ychanged to server %K$1";
    query_move_notify = "%p● %pQuery with %p$0 %pis already created %Kto window $1, use \"/WINDOW ITEM MOVE $0\" to move it to this window";
    hilight_header = "%p● %pHighlights:";
    hilight_line = "$[-4]0 $1 $2 $3$4$5";
    hilight_footer = "";
    hilight_not_found = "%r● %rHighlight not found: %K$0";
    hilight_removed = "%g● %gHighlight removed: %K$0";
    alias_added = "%g● %gAlias %K$0 %gadded";
    alias_removed = "%g● %gAlias %K$0 %gremoved";
    alias_not_found = "%r● %rNo such alias: %K$0";
    aliaslist_header = "%p● %pAliases:";
    aliaslist_line = "$[10]0 $1";
    aliaslist_footer = "";
    log_opened = "%g● %gLog file %K$0 %gopened";
    log_closed = "%g● %gLog file %K$0 %gclosed";
    log_create_failed = "%r● %rCouldn't create log file %K$0%K: $1";
    log_locked = "%r● %rLog file %K$0 %ris locked%K, probably by another running Irssi";
    log_not_open = "%r● %rLog file %K$0 %rnot open";
    log_started = "%g● %gStarted logging %Kto file $0";
    log_stopped = "%r● %rStopped logging %Kto file $0";
    log_list_header = "%p● %pLogs:";
    log_list = "%K$0 $1: $2 $3$4";
    log_list_footer = "";
    windowlog_file = "%g● %gWindow LOGFILE set to %K$0";
    windowlog_file_logging = "%r● %rCan't change window's logfile %Kwhile log is on";
    #   no_away_msgs = "%r● %K%rNo new%K messages in awaylog";
    no_away_msgs = "";
    #   away_msgs = "%g● %K{hilight $1} %gnew messages%K in awaylog:%K";
    away_msgs = "";
    module_header = "Module               Type    Submodules";
    module_line = "$[!20]0 $[7]1 $2";
    module_footer = "";
    module_already_loaded = "%r● %rModule %K$0/$1 %ralready loaded";
    module_not_loaded = "%r● %rModule %K$0/$1 %ris not loaded";
    module_load_error = "%r● %rError loading module %K$0/$1%K: $2";
    module_invalid = "%r● %K$0/$1 %risn't Irssi module";
    module_loaded = "%g● %gLoaded module %K$0/$1";
    module_unloaded = "%r● %rUnloaded module %K$0/$1";
    command_unknown = "%r● %rUnknown command: $0";
    command_ambiguous = "%r● %rAmbiguous command: $0";
    option_unknown = "%r● %rUnknown option: $0";
    option_ambiguous = "%r● %rAmbiguous option: $0";
    option_missing_arg = "%r● %rMissing required argument for: $0";
    not_enough_params = "%r● %rNot enough parameters given";
    not_connected = "%r● %rNot connected to server";
    not_joined = "%r● %rNot joined to any channel";
    chan_not_found = "%r● %rNot joined to such channel";
    chan_not_synced = "%r● %rChannel not fully synchronized yet, try again after a while";
    illegal_proto = "%r● %rCommand isn't designed for the chat protocol of the active server";
    not_good_idea = "%r● %rDoing this is not a good idea. Add -YES if you really mean it";
    theme_saved = "%g● %gTheme saved %Kto $0";
    theme_save_failed = "%r● %rError saving theme %Kto $0: $1";
    theme_not_found = "%r● %rTheme %K$0 %rnot found";
    theme_changed = "%y● %yUsing now theme %y$0 %K($1)";
    window_theme = "%g● %gUsing theme %g$0 %Kin this window";
    window_theme_default = "%r● %rNo theme is set %Kfor this window";
    window_theme_changed = "%y● %yUsing now theme %y$0 %K($1) in this window";
    window_theme_removed = "%g● %gRemoved theme %Kfrom this window";
    format_title = "%:[{hilight $0}] - [{hilight $1}]%:";
    format_subtitle = "[{hilight $0}]";
    format_item = "$0 = $1";
    ignored = "%g● %gIgnoring %g$1 %Kfrom $0";
    unignored = "%g● %gUnignored %g$0";
    ignore_not_found = "%g● %g$0 %gis not being ignored";
    ignore_no_ignores = "%p● %pThere are no ignores";
    ignore_header = "%p● %pIgnorance list:";
    ignore_line = "$[-4]0 $1: $2 $3 $4";
    ignore_footer = "";
    unknown_chat_protocol = "%r● %rUnknown chat protocol: $0";
    unknown_chatnet = "%r● %rUnknown chat network: $0 (create it with /IRCNET ADD)";
    not_toggle = "%r● %rValue must be either ON, OFF or TOGGLE";
    perl_error = "%r● %rPerl error: $0";
    bind_key = "$[!20]0 $1 $2";
    bind_unknown_id = "%r● %rUnknown bind action: $0";
    config_saved = "%g● %gSaved configuration to file $0";
    config_reloaded = "%g● %gReloaded configuration";
    config_modified = "%p● %pConfiguration file was modified since irssi was last started - do you want to overwrite the possible changes?";
    glib_error = "{error GLib $0} $1";
    overwrite_config = "%p● %pOverwrite config (%gy%K/%rN%K)?";
    set_title = "[{hilight $0}]";
    set_item = "$0 = $1";
    set_unknown = "%r● %rUnknown setting $0";
    set_not_boolean = "%r● %rSetting {hilight $0} isn't boolean, use /SET";
    translation_not_found = "%r● %rError opening translation table file $0: $1";
    translation_file_error = "%r● %rError parsing translation table file $0";

    #privat:

    own_msg_private_query = "{ownprivmsgnick {ownprivnick $[-10]2}}%W$1";
    own_msg_private = "{ownprivmsg msg $0}%W$1";
    msg_private_query = "{privmsgnick {privnick $[-10]0}}%W$2";
    msg_private = "{privmsg $0 $1}%W$2";

    # msn-styled:
    # own_msg_private_query = "{ownprivnick $2}%w$1%:";
    # msg_private_query = "{privmsgnick $0}%w$2%:";

  };
  "fe-common/irc/dcc" = {
    dcc_list_header = "{line_start_irssi}{dcc DCC connections:}";
    dcc_list_footer = "{line_start_irssi}{dcc ];}";
    #   own_dcc = "{dccownmsg dcc {dccownnick $1}}$2";
    #   own_dcc_action = "{dccownaction_target $0 $1}$2";
    #   own_dcc_action_query = "{dccownaction $0}$2";
    #   own_dcc_ctcp = "{ownctcp ctcp $0}$1 $2";
    #   dcc_msg = "{dccmsg dcc $0}$1";
    #   action_dcc = "{dccaction $0}$1";
    #   action_dcc_query = "{dccaction $0}$1";
    #   own_dcc_query = "{ownmsgnick {dccownquerynick $0}}$2";
    #   dcc_msg_query = "{privmsgnick $0}$1";
    dcc_ctcp = "%g● %g{dcc >>> DCC CTCP {hilight $1} received from {hilight $0}: $2}";
    dcc_chat = "%g● %g{dcc DCC CHAT from {nick $0} [$1 port $2]}";
    dcc_chat_channel = "%g● %g{dcc DCC CHAT from {nick $0} [$1 port $2] requested in channel {channel $3}}";
    dcc_chat_not_found = "%g● %g{dcc No DCC CHAT connection open to {nick $0}}";
    dcc_chat_connected = "%g● %g{dcc DCC CHAT connection with {nick $0} [$1 port $2] established}";
    dcc_chat_disconnected = "%r● %r{dcc DCC lost chat to {nick $0}}";
    dcc_send = "%g● %g{dcc DCC SEND from {nick $0} [$1 port $2]: $3 [$4 bytes]}";
    dcc_send_channel = "%g● %g{dcc DCC SEND from {nick $0} [$1 port $2]: $3 [$4 bytes] requested in channel {channel $5}}";
    dcc_send_exists = "%r● %r{dcc DCC already sending file {dccfile $0} for {nick $1}}";
    dcc_send_not_found = "%r● %r{dcc DCC not sending file {dccfile $1} to {nick $0}}";
    dcc_send_file_open_error = "%r● %r{dcc DCC can't open file {dccfile $0}: $1}";
    dcc_send_connected = "%g● %g{dcc DCC sending file {dccfile $0} for {nick $1} [$2 port $3]}";
    dcc_send_complete = "%g● %g{dcc DCC sent file {dccfile $0} [{hilight $1}kB] for {nick $2} in {hilight $3} secs [{hilight $4kB/s}]}";
    dcc_send_aborted = "%r● %r{dcc DCC aborted sending file {dccfile $0} for {nick $1}}";
    dcc_get_not_found = "%r● %r{dcc DCC no file offered by {nick $0}}";
    dcc_get_connected = "%g● %g{dcc DCC receiving file {dccfile $0} from {nick $1} [$2 port $3]}";
    dcc_get_complete = "%g● %g{dcc DCC received file {dccfile $0} [$1kB] from {nick $2} in {hilight $3} secs [$4kB/s]}";
    dcc_get_aborted = "%r● %r{dcc DCC aborted receiving file {dccfile $0} from {nick $1}}";
    dcc_unknown_ctcp = "%r● %r{dcc DCC unknown ctcp {hilight $0} from {nick $1} [$2]}";
    dcc_unknown_reply = "%r● %r{dcc DCC unknown reply {hilight $0} from {nick $1} [$2]}";
    dcc_unknown_type = "%r● %r{dcc DCC unknown type {hilight $0}}";
    dcc_invalid_ctcp = "%r● %r{dcc DCC received CTCP {hilight $0} with invalid parameters from {nick $1}}";
    dcc_connect_error = "%r● %r{dcc DCC can't connect to {hilight $0} port {hilight $1}}";
    dcc_cant_create = "%r● %r{dcc DCC can't create file {dccfile $0}}";
    dcc_rejected = "%r● %r{dcc DCC $0 was rejected by {nick $1} [{hilight $2}]}";
    dcc_request_send = "%g● %g{dcc DCC $0 request sent to {nick $1}: $2";
