[user]
  email = prashantrameshtak@gmail.com
  name = brongulus
[github]
  user = brongulus
[FORGE "HOST"]
  user = brongulus
# https://blog.gitbutler.com/how-git-core-devs-configure-git/
[column]
  ui = auto
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[diff]
  algorithm = histogram
  colorMoved = plain
[rebase]
  autoStash = true
  updateRefs = true
# https://jvns.ca/blog/2024/02/16/popular-git-config-options/
[push]
  # Automatically set origin as the remote for current branch
  autoSetupRemote = true
  autoSetupMerge = always
[url "git@github.com:"]
  pushInsteadOf = "https://github.com/"
# Delta
[core]
  # pager = delta --pager='bat --style=plain'
  editor = "emacsclient -a="
  excludesfile = ~/.gitignore
  # sshCommand = ssh -i ~/.ssh/id_ed25519 -o IdentitiesOnly=yes
[interactive]
  diffFilter = delta --color-only
[delta]
  side-by-side = true
  navigate = true    # use n and N to move between diff sections
[mergetool "ediff"]
  cmd = emacs -nw --eval \"(progn \
  (setq smerge-command-prefix \\\"v\\\") \
  (find-file \\\"$MERGED\\\") \
  (setq confirm-kill-emacs nil hl-line-mode nil) \
  (bind-key \\\"Q\\\" (lambda nil (interactive) (save-buffers-kill-emacs t))) \
  (smerge-mode 1) (repeat-mode 1) \
  (setq diff-refine 'navigation) \
  (map-keymap (lambda (_key cmd) (when (symbolp cmd) \
       (put cmd 'repeat-map 'smerge-basic-map))) smerge-basic-map))\"
#   cmd = emacs -nw --eval \"(ediff-merge-files-with-ancestor \\\"$LOCAL\\\" \\\"$REMOTE\\\" \\\"$BASE\\\" nil \\\"$MERGED\\\")\"
[mergetool]
  keepBackup = false
[merge]
  tool = ediff
  conflictstyle = zdiff3
# Ref: https://stackoverflow.com/a/43654115 (git config --list)
[includeIf "gitdir:~/work/"]
  path = ~/work/.gitconfig
[includeIf "gitdir:~/go/src/"]
  path = ~/go/src/.gitconfig
