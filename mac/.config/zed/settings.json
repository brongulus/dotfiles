// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "disable_ai": true,
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^emacs\\b"
            },
            {
              "pattern": "^sleep\\s+10(\\s|$)"
            },
            {
              "pattern": "^cat\\s+/tmp/tab\\-redef\\.txt(\\s|$)"
            }
          ]
        }
      }
    },
    "dock": "right",
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-opus-4.6",
    },
  },
  "vim_mode": true,
  "helix_mode": true,
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },
  "buffer_font_family": "Input Mono Narrow",
  "buffer_font_weight": 400,
  "ui_font_size": 15,
  "buffer_font_size": 14.5,
  "vertical_scroll_margin": 999,
  "scroll_beyond_last_line": "one_page",
  "cursor_blink": false,
  "theme": {
    "mode": "dark",
    "light": "Alabaster BG High Contrast",
    "dark": "One Dark",
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "errors",
  },
  "scrollbar": { "show": "never" },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
  },
  "terminal": {
    "font_size": 14,
    "shell": { "program": "fish" },
    "toolbar": { "breadcrumbs": false },
  },
  "diagnostics": { "inline": { "enabled": true } },
  "inlay_hints": { "enabled": false },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "diff_view_style": "split",
  "always_treat_brackets_as_autoclosed": true,
  "preferred_line_length": 98,
  "soft_wrap": "none",
}
