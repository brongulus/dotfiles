general {
    output_format = "i3bar"
    colors = false
    interval = 5
}

order += "wireless wlp3s0"
order += "battery 0"
order += "tztime local"

wireless wlp3s0 {
    # format_up = "W: %essid, %bitrate"
    format_up = ""
    format_down = "W: down"
}

ethernet eth0 {
    format_up = "E: %ip (%speed)"
    format_down = "E: down"
}

battery 0 {
    format = "%status %percentage"# %remaining"
    format_down = "No battery"
    status_chr = "⚡"
    status_bat = ""
    status_unk = "?"
    status_full = "FULL"
    status_idle = "IDLE"
    path = "/sys/class/power_supply/BAT%d/uevent"
    low_threshold = 10
}

tztime local {
    format = "%H:%M "
}

memory {
    format = "%used"
    threshold_degraded = "10%"
    format_degraded = "MEMORY: %free"
}

disk "/" {
    format = "%free"
}

read_file uptime {
    path = "/proc/uptime"
}
