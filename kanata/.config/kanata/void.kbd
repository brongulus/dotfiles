#|
https://github.com/jtroo/kanata/blob/main/docs/setup-linux.md
|#

(defcfg
  process-unmapped-keys no
  log-layer-changes yes
  linux-output-device-bus-type USB
  ;; log-layer-changes-name-only yes
  danger-enable-cmd yes
  ;; https://github.com/jtroo/kanata/issues/1982
  ;; macos-dev-names-include (
  ;;   "Apple Internal Keyboard / Trackpad"
  ;;   "HHKB-Hybrid_1"
  ;;   "HHKB-Classic"
  ;;   "MINILA-R Convertible"
  ;; )
  ;; movemouse-inherit-accel-state yes
)

(defsrc
  esc    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab    q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps   a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft   z    x    c    v    b    n    m    ,    .    /    ▲   rsft
  wkup lctl  lalt lmet          spc         rmet ralt ◀    ▼    ▶
)

(deflayer qwerty
  @esp  🔅   🔆   f3   f4   f5   f6   ◀◀   ▶⏸   ▶▶   🔇   🔉  🔊
  grv    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab    q    w    e    r    t    y    u    i    o    p    [    ]    \
  @cap   a    s    d    f    g    h    j    k    l    ;    '    @rat
  lsft   z    x    c    v    b    n    m    ,    .    /    ▲   rsft
  @fnl lctl  lalt lmet          spc         rmet ralt ◀    ▼    ▶
)

(deflayer dvorak
  @esp  🔅   🔆   f3   f4   f5   f6   ◀◀   ▶⏸   ▶▶   🔇   🔉  🔊
  grv    1    2    3    4    5    6    7    8    9    0    [    ]    bspc
  tab    '    ,    .    p    y    f    g    c    r    l    /    =    \
  @cap   a    o    e    u    i    d    h    t    n    s    -   @rat
  lsft   ;    q    j    k    x    b    m    w    v    z    ▲   rsft
  @fnl lctl  lalt lmet          spc         rmet ralt ◀    ▼    ▶
)

;; (deflayer hhkb
;;   esc   🔅   🔆   f3   f4   f5   f6   ◀◀   ▶⏸   ▶▶   🔇   🔉  🔊
;;   @grl   1    2    3    4    5    6    7    8    9    0    -    =    |   bspc
;;   tab    q    w    e    r    t    y    u    i    o    p    [    ]   @rat
;;   @cap   a    s    d    f    g    h    j    k    l    ;    '   bspc
;;   lsft   z    x    c    v    b    n    m   @rm  @ra  @rc   \    ▲   rsft
;;   @fnl @lct  lmet lalt @lct spc        @rc @rmet ralt fn   ◀    ▼    ▶
;; )

(deflayer hs-alt
  _     f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  _      _    _    _    _    _    _    _    _    _    _    _    _    _
  _    mlft @msu mrgt @mdb   _    _    _    _    _    _    _    _    _
  _    @msl @msd @msr   _    _    _    _    _    _  @mwu @mwd   _
  _    @cl  @mwr @mwl  @cr   _    _    _    @cl @cr   _    _    _
  _      _    _    _              _         _    _    _    _    _
)

(deflayer layers
  _      _    _    _    _    _    _    _    _    _    _    _    _
  _      @qwr @dvk _    _    _    _    _    _    _    _    _    _    _
  _      _    _    _   lrld  _    _    _    _    _    _    _    _    _
  _      _    _    _    _    _    _    _    _    _    _    _    _
  _      _    _    _    _    _    _    _    _    _    _    _    _
  _      _    _    _              _         _    _    _    _    _
)

(defalias
  dvk (layer-switch dvorak)
  qwr (layer-switch qwerty)
  ;; hkb (layer-switch hkb)
  esp (tap-hold-press 200 200 esc (layer-toggle layers))
  cap (tap-hold-press 200 200 esc lctl)
  lct (tap-hold-press 200 200 esc lctl)
  fnl (tap-hold-press 200 200 ret (layer-toggle hs-alt))
  rat (tap-hold-press 200 200 ret (layer-toggle hs-alt))
  ;; lc (tap-hold 200 200 z lctl)
  ;; la (tap-hold 200 200 x lalt)
  ;; lm (tap-hold 200 200 c lmet)
  ;; rm (tap-hold 200 200 , rmet)
  ;; ra (tap-hold 200 200 . lalt)
  ;; rc (tap-hold 200 200 / @lct)

  ;; mwu (mwheel-accel-up 3 1200 1.15 0.93)
  ;; mwd (mwheel-accel-down 3 1200 1.15 0.93)
  mwu (mwheel-up 50 5)
  mwd (mwheel-down 50 5)
  mwl (mwheel-left 25 5)
  mwr (mwheel-right 25 5)
  mdb (macro (mltp 200 mlft))
  msu (movemouse-accel-up 4 1000 1 5)
  msd (movemouse-accel-down 4 1000 1 5)
  msl (movemouse-accel-left 4 1000 1 5)
  msr (movemouse-accel-right 4 1000 1 5)
  mgr C-mlft ;; FIXME

  cl C-A-left
  cr C-A-right
)

