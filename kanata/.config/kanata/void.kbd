#|
https://github.com/jtroo/kanata/blob/main/docs/setup-linux.md
|#

(defcfg
  process-unmapped-keys no
  log-layer-changes yes
  linux-output-device-bus-type USB
  ;; log-layer-changes-name-only yes
  danger-enable-cmd yes
  ;; https://github.com/jtroo/kanata/issues/1982
  ;; macos-dev-names-include (
  ;;   "Apple Internal Keyboard / Trackpad"
  ;;   "HHKB-Hybrid_1"
  ;;   "HHKB-Classic"
  ;;   "MINILA-R Convertible"
  ;; )
  ;; movemouse-inherit-accel-state yes
)

(defsrc
  esc    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab    q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps   a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft   z    x    c    v    b    n    m    ,    .    /    ▲   rsft
  wkup lctl  lalt lmet          spc         rmet ralt ◀    ▼    ▶
)

(deflayer qwerty
  @esp  🔅   🔆   f3   f4   f5   f6   ◀◀   ▶⏸   ▶▶   🔇   🔉  🔊
  grv    1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab    q    w    e    r    t    y    u    i    o    p    [    ]    \
  @cap   a    s    d    f    g    h    j    k    l   @scl  '   @rat
  lsft   z    x    c    v    b    n    m    ,    .    /    ▲   rsft
  @fnl lctl  lalt lmet          spc         rmet ralt ◀    ▼    ▶
)

(deflayer dvorak
  @esp  🔅   🔆   f3   f4   f5   f6   ◀◀   ▶⏸   ▶▶   🔇   🔉  🔊
  grv    1    2    3    4    5    6    7    8    9    0    [    ]    bspc
  tab    '    ,    .    p    y    f    g    c    r    l    /    =    \
  @cap   a    o    e    u    i    d    h    t    n    s    -   @rat
  lsft   ;    q    j    k    x    b    m    w    v    z    ▲   rsft
  @fnl lctl  lalt lmet          spc         rmet ralt ◀    ▼    ▶
)

(deflayer hs
  _     f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
 @prm    _    _    _    _    _    _    _    _    _    _    _    _    _
  _     mlft @msu mrgt @i3r  _    _    _    _    _    _    _    _    _
  _     @msl @msd @msr @ytf  _  @yfw @yfs @yfn @yfe   _    _    _
  _     @cl  @mwr @mwl @yts  _    _    _   @cl  @cr   _  @mwd   _
  _      _    _    _            @ytm        _    _   @cl @mwu  @cr
)

(deflayer hs-alt
  _     f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
 @prm   _    _    _     _    _    _    _    _    _    _    _    _    _
  _    mlft @msu mrgt   _    _  @ysw @yss @ysn @yse   _    _    _    _
  _    @msl @msd @msr   _    _  @yiw @yis @yin @yie @mwu @mwd   _
  _    @cl  @mwr @mwl  @cr   _    _    _   @cl  @cr   _    _    _
  _      _    _    _            @ytm        _    _   @cl   _   @cr
)

(deflayer fn-lyr
  _     f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
 @rft   @oem  _    _    _   @off  _    _    _    _   @vmt @vlw @vup  _
 @rft   @i3k  _    _   @rfp  _    _    _    _    _    _    _    _    _
  _      _    _    _    _    _    _    _    _    _    _    _   @okt
  _      _   @rfo  _    _    _    _   @bpm  _    _    _    _    _
  _      _    _    _            @rfo        _    _    _    _    _
)

(deflayer layers
  _      _    _    _    _    _    _    _    _    _    _    _    _
  _      @qwr @dvk _    _    _    _    _    _    _    _    _    _    _
  _      _    _    _   lrld  _    _    _    _    _    _    _    _    _
  _      _    _    _    _    _    _    _    _    _    _    _    _
  _      _    _    _    _    _    _    _    _    _    _    _    _
  _      _    _    _              _         _    _    _    _    _
)

(defalias
  dvk (layer-switch dvorak)
  qwr (layer-switch qwerty)
  ;; hkb (layer-switch hkb)
  esp (tap-hold-press 200 200 esc (layer-toggle layers))
  cap (tap-hold-press 200 200 esc lctl)
  lct (tap-hold-press 200 200 esc lctl)
  fnl (tap-hold-press 200 200 ret (layer-toggle fn-lyr))
  scl (tap-hold-press 200 400 ; (layer-toggle hs))
  rat (tap-hold-press 200 200 ret (layer-toggle hs-alt))

  mwu (mwheel-down 50 120)
  mwd (mwheel-up 50 120)
  mwl (mwheel-left 25 120)
  mwr (mwheel-right 25 120)
  msu (movemouse-accel-up 4 1000 1 5)
  msd (movemouse-accel-down 4 1000 1 5)
  msl (movemouse-accel-left 4 1000 1 5)
  msr (movemouse-accel-right 4 1000 1 5)

  vmt (cmd bash -c "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle")
  vlw (cmd bash -c "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-")
  vup (cmd bash -c "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+")

  prm (cmd bash -c "(pgrep picom && pkill picom) || picom")
  i3k (cmd bash -c "i3-msg kill")
  i3r (cmd bash -c "i3-msg restart")
  cl (cmd bash -c "i3-msg workspace prev")
  cr (cmd bash -c "i3-msg workspace next")
)

(defalias
  ytf (cmd bash -c "i3-msg fullscreen toggle")
  ytm (cmd bash -c "i3-msg floating toggle")
  yts (cmd bash -c "i3-msg layout toggle split")

  yfw (cmd bash -c "i3-msg focus left")
  yfs (cmd bash -c "i3-msg focus down")
  yfn (cmd bash -c "i3-msg focus up")
  yfe (cmd bash -c "i3-msg focus right")

  ysw (cmd bash -c "i3-msg move left")
  yss (cmd bash -c "i3-msg move down")
  ysn (cmd bash -c "i3-msg move up")
  yse (cmd bash -c "i3-msg move right")

  yiw (cmd bash -c "i3-msg 'focus left; split v; layout tabbed; mark _dst; focus right; move container to mark _dst; unmark _dst'")
  yis (cmd bash -c "i3-msg 'focus down; split v; layout tabbed; mark _dst; focus up; move container to mark _dst; unmark _dst'")
  yin (cmd bash -c "i3-msg 'focus up; split v; layout tabbed; mark _dst; focus down; move container to mark _dst; unmark _dst'")
  yie (cmd bash -c "i3-msg 'focus right; split v; layout tabbed; mark _dst; focus left; move container to mark _dst; unmark _dst'")

  bpm (cmd bash -c "bspc node --flag hidden=on")
  rfp (cmd bash -c "~/.config/i3/power.sh")
  rfo (cmd bash -c "dmenu_run -i -b -nb '#121212' -nf '#cdcab1' -sb '#242424' -fn 'monospace:10'")
  rft (cmd bash -c "~/.config/i3/window.sh")
  okt (cmd bash -c "ghostty")
  oem (cmd bash -c "emacs")
  off (cmd bash -c "firefox")
)
